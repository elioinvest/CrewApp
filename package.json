{
  "name": "crew-app",
  "version": "0.1.0",
  "private": true,
  "description": "Crew on your phone: a native Android app (android/) and the web version Crew serves to phone browsers (www/).",
  "license": "MIT",
  "scripts": {
    "vendor": "node scripts/vendor.js",
    "crew": "npm run vendor && node scripts/to-crew.js",
    "serve": "npx http-server www -p 8090 -c-1",
    "apk": "cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  }
}
